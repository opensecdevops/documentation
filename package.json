{
  "name": "osdo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start --port 8080",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "crowdin:upload": "crowdin upload sources --config ./crowdin-v2.yaml",
    "crowdin:download": "crowdin download --config ./crowdin-v2.yaml",
    "crowdin:sync": "docusaurus write-translations && npm run crowdin:upload &&  npm run crowdin:download",
    "build:gitlab": "docusaurus build --out-dir public"
  },
  "dependencies": {
    "@crowdin/cli": "^3.15.0",
    "@docusaurus/core": "^3.8.0",
    "@docusaurus/preset-classic": "^3.8.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^1.2.1",
    "dotenv": "^16.3.1",
    "prism-react-renderer": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.8.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=16.14"
  }
}
